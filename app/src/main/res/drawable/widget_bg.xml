<?xml version="1.0" encoding="utf-8"?>
<!-- Un dégradé très doux plutôt qu'un aplat blanc : posé sur un fond d'écran, un carré
     blanc franc se lit comme un trou dans l'écran. Le dégradé lui donne une épaisseur. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:startColor="#FFFDF3F6"
        android:endColor="#FFFFFFFF"
        android:angle="270" />
    <corners android:radius="28dp" />
    <stroke android:width="1dp" android:color="#22C03765" />
</shape>
