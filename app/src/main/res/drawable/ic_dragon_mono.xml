<!--
  La silhouette entière — tête, cornes et corps — pour la couche `monochrome` des icônes
  de lanceur.

  C'était le même dessin que `ic_stat_dragon` jusqu'à ce que celui-ci grossisse. Les deux
  vivent maintenant chacun de leur côté parce qu'ils n'ont pas la même contrainte : une
  icône adaptative est découpée par un masque et ne garantit que le cercle central de 72
  sur 108, alors qu'une icône de barre d'état occupe tout son carré. Un seul fichier
  obligeait à respecter la plus sévère des deux, c'est-à-dire à rester petit là où il n'y
  avait aucune raison de l'être.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="108" android:viewportHeight="108">
  <group android:scaleX="0.40" android:scaleY="0.40"
      android:translateX="10" android:translateY="4">
    <path android:fillColor="#FFFFFFFF" android:pathData="M 84,58 C 64,42 58,20 68,4 C 80,22 100,42 108,54 Z"/>
    <path android:fillColor="#FFFFFFFF" android:pathData="M 64,78 C 46,64 36,44 40,28 C 55,42 74,60 80,70 Z"/>
    <group android:translateX="220" android:scaleX="-1">
      <path android:fillColor="#FFFFFFFF" android:pathData="M 84,58 C 64,42 58,20 68,4 C 80,22 100,42 108,54 Z"/>
      <path android:fillColor="#FFFFFFFF" android:pathData="M 64,78 C 46,64 36,44 40,28 C 55,42 74,60 80,70 Z"/>
    </group>
    <path android:fillColor="#FFFFFFFF" android:pathData="M65,74 a45,40 0 1,0 90,0 a45,40 0 1,0 -90,0 Z"/>
    <path android:fillColor="#FFFFFFFF" android:pathData="M 110,112 C 90,112 80,124 77,142 C 72,163 76,184 88,192 C 99,198 121,198 132,192 C 144,184 148,163 143,142 C 140,124 130,112 110,112 Z"/>
  </group>
</vector>
