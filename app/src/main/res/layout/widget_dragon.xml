<?xml version="1.0" encoding="utf-8"?>
<!-- La tuile, en trois bandes.

     En haut la barre d'état : la flamme framboise et son chiffre à gauche, la semaine à
     droite. Au milieu la phrase écrite à la main, qui prend tout ce qui reste. En bas le
     dragon, posé À DROITE et sur la ligne d'horizon du décor — un dragon centré au milieu
     d'un paysage a l'air découpé et recollé ; contre le bord, il a l'air d'y être.

     La phrase est en `autoSizeTextType` entre 11 et 27 sp : « jamais deux sans toi » sort
     en très gros, le couplet de Life Is A Highway rétrécit juste ce qu'il faut, et aucun
     des deux ne finit en points de suspension. C'est la seule façon d'afficher sur deux
     cases des textes qui vont de vingt à cent dix caractères.

     Tout le texte est blanc avec une ombre portée : le décor derrière change huit fois
     par jour et le fond de la tuile porte déjà un voile sombre sous cette bande, donc le
     blanc est la seule encre qui tienne du ciel de midi à la nuit noire. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_week"
                android:layout_width="0dp"
                android:layout_height="17dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:scaleType="fitEnd"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical|start"
            android:maxLines="5"
            android:ellipsize="end"
            android:lineSpacingMultiplier="0.98"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="27sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="jamais deux sans toi" />

        <!-- Le dragon à droite, le mot du jour à gauche : la lecture va du texte vers le
             personnage, et le personnage ferme la tuile au lieu de la couper en deux. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/widget_mood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:gravity="bottom|start"
                android:maxLines="2"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="#F2FFFFFF"
                android:textStyle="bold"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="C'est l'heure" />

            <ImageView
                android:id="@+id/widget_dragon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:scaleType="fitCenter"
                android:contentDescription="Framboise" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
