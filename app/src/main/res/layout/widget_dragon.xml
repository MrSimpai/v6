<?xml version="1.0" encoding="utf-8"?>
<!-- Le dragon à gauche, tout le texte à droite, hiérarchisé du plus gros au plus fin :
     le nombre, ce que dit le dragon, puis la phrase de la série. Aucun bouton — noter une
     dose se fait dans l'app, où l'on peut confirmer et célébrer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/widget_dragon"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:contentDescription="Framboise" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="3dp"
            android:paddingBottom="4dp"
            android:background="@drawable/widget_streak_bg"
            android:textColor="#FF3FA98D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="12 jours" />

        <TextView
            android:id="@+id/widget_mood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FF3B1327"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="Une dose t'attend." />

        <TextView
            android:id="@+id/widget_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FF9C7383"
            android:textSize="12sp"
            android:text="" />
    </LinearLayout>
</LinearLayout>
