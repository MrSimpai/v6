<?xml version="1.0" encoding="utf-8"?>
<!-- Carré 2x2, monté comme la tuile de Duolingo, mais autour de la ligne du jour.

     Trois bandes : la barre d'état (série à gauche, semaine à droite), le message
     écrit à la main au milieu — c'est LUI qui prend toute la place qui reste — et le
     dragon avec l'état du moment en bas.

     Le message est en `autoSizeTextType` : les lignes courtes s'affichent en très gros,
     les longues rétrécissent juste ce qu'il faut. C'est la seule façon d'afficher en
     entier des textes qui vont de vingt à cent dix caractères sur deux cases, sans
     jamais couper la chute d'une blague.

     Le dragon a perdu de la taille au profit du texte. C'est le bon échange ici : le
     dessin est le même toute la journée, la phrase change tous les jours. Et la tuile
     est redimensionnable, donc l'agrandir rend les deux plus gros. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="7dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_week"
                android:layout_width="0dp"
                android:layout_height="9dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:scaleType="fitEnd"
                android:contentDescription="@null" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical|start"
            android:maxLines="5"
            android:ellipsize="end"
            android:lineSpacingMultiplier="0.98"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="26sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:shadowColor="#A6000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="jamais deux sans toi" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <ImageView
                android:id="@+id/widget_dragon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:scaleType="fitCenter"
                android:contentDescription="Framboise" />

            <TextView
                android:id="@+id/widget_mood"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="bottom|start"
                android:maxLines="2"
                android:ellipsize="end"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:textColor="#E6FFFFFF"
                android:shadowColor="#A6000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="C'est l'heure" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
