<?xml version="1.0" encoding="utf-8"?>
<!-- Carré 2x2, monté comme la tuile de Duolingo : une barre d'état en haut (la série à
     gauche, la semaine à droite), une phrase courte, et le dragon qui prend TOUT le reste.

     Le dragon est en `layout_weight` et pas en taille fixe : c'est lui qui absorbe la
     hauteur qui reste, donc la tuile est pleine quelle que soit la grille du lanceur au
     lieu de laisser une bordure vide autour d'un petit dessin centré. La série et la
     semaine partagent une seule ligne pour la même raison — deux lignes lui coûtaient un
     quart de sa taille.

     Le fond est une image peinte, pas une forme XML, donc il porte la lune, les braises
     et la pluie, et change avec l'humeur. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_week"
                android:layout_width="0dp"
                android:layout_height="9dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:scaleType="fitEnd"
                android:contentDescription="@null" />
        </LinearLayout>

        <!-- La phrase se met à la taille de la tuile au lieu d'être coupée : avec
             `maxLines` seul, la moitié des lignes finissait en « … » et le rappel ne
             voulait plus rien dire. -->
        <TextView
            android:id="@+id/widget_mood"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:maxLines="3"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Une dose t'attend." />

        <ImageView
            android:id="@+id/widget_dragon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:scaleType="fitCenter"
            android:contentDescription="Framboise" />
    </LinearLayout>
</FrameLayout>
